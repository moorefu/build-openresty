diff --git a/ngx_http_proxy_connect_module.c b/ngx_http_proxy_connect_module.c
index cd7e517..fa151dd 100644
--- a/ngx_http_proxy_connect_module.c
+++ b/ngx_http_proxy_connect_module.c
@@ -1758,12 +1758,20 @@ ngx_http_proxy_connect_allow(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
 static char *
 ngx_http_proxy_connect(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
 {
+    ngx_http_core_srv_conf_t            *cscf;
     ngx_http_core_loc_conf_t            *clcf;
     ngx_http_proxy_connect_loc_conf_t   *pclcf;
 
     clcf = ngx_http_conf_get_module_loc_conf(cf, ngx_http_core_module);
